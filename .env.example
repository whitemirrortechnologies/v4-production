# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# the "anon" / "publishable" key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never commit.
# Used for confirming payments and admin-only server tasks.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_NAME=V4

# Public URL of the site (for sitemap, share images, email links), e.g. https://v4.example.com
NEXT_PUBLIC_SITE_URL=
# Shown on the Contact page
NEXT_PUBLIC_SUPPORT_EMAIL=
