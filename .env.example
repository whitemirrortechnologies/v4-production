# Copy to .env.local and fill in. Never commit .env.local.

# --- Cloudflare R2 (lecture videos) — see docs/setup/cloudflare-r2.md ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=v4-videos
# Leave empty for real R2 (derived from R2_ACCOUNT_ID). Only set for a local S3 emulator.
R2_ENDPOINT=
# Origin the browser app runs on; used by the CORS check.
APP_ORIGIN=http://localhost:3000
